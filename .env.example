VITE_SUPABASE_URL=your_supabase_url_here
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
# Public half of the web push VAPID keypair (generate with:
# npx web-push generate-vapid-keys). Safe to expose client-side; the private
# half is a Supabase Edge Function secret only (see supabase/functions/send-push).
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
